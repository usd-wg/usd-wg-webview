{
  "name": "usd-webview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000 --strictPort",
    "test": "vitest run && node tests/regression/run.mjs",
    "test:unit": "vitest run",
    "test:regression": "node tests/regression/run.mjs",
    "test:regression:bless": "node tests/regression/run.mjs --update-baselines",
    "materialx:fetch": "node tools/materialx/fetch-official-runtime.mjs",
    "native:stamp": "node tools/native-build/stamp-build.mjs",
    "native:build": "cmake --build build/usd-webview-bindings --target install && npm run native:stamp",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8000 --strictPort",
    "usd-material-fidelity": "node tools/usd-material-fidelity/run.mjs",
    "usd-material-fidelity:all": "node tools/usd-material-fidelity/run.mjs --all",
    "usd-material-fidelity:render": "node tools/usd-material-fidelity/render-webview.mjs",
    "usd-material-fidelity:diff": "node tools/usd-material-fidelity/diff.mjs",
    "usd-material-fidelity:setup": "node tools/usd-material-fidelity/setup.mjs",
    "usd-material-fidelity:shaderball": "node tools/usd-material-fidelity/shaderball.mjs",
    "usd-material-fidelity:shaderball:all": "node tools/usd-material-fidelity/shaderball.mjs --all",
    "usd-material-fidelity:shaderball:streams": "node tools/usd-material-fidelity/verify-shaderball-streams.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.0.0",
    "three": "https://codeload.github.com/mrdoob/three.js/tar.gz/16e7674dbcda5137e48953959bdf5275f834642a"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "vitest": "^4.1.10"
  }
}
